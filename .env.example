# AI OS environment configuration — copy to `.env` and adjust.
# `.env` is gitignored: keys must never reach the renderer bundle or source control.
# Everything below defaults to a $0 setup (local Ollama); no paid service is required.

# Provider: ollama (default, free/local) or openai (any OpenAI-compatible endpoint)
AIOS_PROVIDER=ollama

# --- Ollama (local, free) ---
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2:1b

# --- OpenAI-compatible endpoint (optional; also works with local LM Studio / llama.cpp) ---
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Extra folders the Files app and the read-only list_folder tool may access.
# Separate with `;`. Leave empty for Documents, Desktop, Downloads.
# Example: AIOS_ALLOWED_FOLDERS=C:\Users\me\Documents;D:\work\notes
AIOS_ALLOWED_FOLDERS=

# Global shortcut that summons the JARVIS overlay (Electron accelerator syntax)
AIOS_SUMMON_SHORTCUT=Alt+Space

# Speech-to-text runs fully offline on this machine (Whisper). No API key needed.
# The model downloads once on first use (about 40 MB) and is cached in the app data folder.
# Optional: pick another model (e.g. Xenova/whisper-base for multilingual) and a language code.
AIOS_STT_MODEL=Xenova/whisper-tiny.en
AIOS_STT_LANGUAGE=
